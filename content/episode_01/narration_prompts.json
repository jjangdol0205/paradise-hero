    {
      "segment_id": "ep01_seg_15",
      "chapter_index": 3,
      "chapter_id": "ch3_song_commentary",
      "chapter_title": "명곡 해설 — '내가 그대 편이 되겠소', [당신 편] 가사 속 눈물의 약속",
